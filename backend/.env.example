# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Credentials (Obtain from your Supabase Project Settings -> API)
# The service-role key is kept strictly on the backend and NEVER exposed to frontend.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for fallback auth verification
JWT_SECRET=grems_academic_secure_jwt_secret_key_2026

